{
  "name": "pica-engine",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.18.0",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "lint": "eslint --max-warnings 0 .",
    "lint-arch": "node --experimental-strip-types --disable-warning=ExperimentalWarning tools/lint-arch/main.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "protocol-schema": "node --experimental-strip-types --disable-warning=ExperimentalWarning tools/protocol-schema/main.ts",
    "swift-codegen": "node --experimental-strip-types --disable-warning=ExperimentalWarning tools/swift-codegen/main.ts",
    "config-schema": "node --experimental-strip-types --disable-warning=ExperimentalWarning tools/config-schema/main.ts"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.5",
    "eslint": "^10.14.0",
    "fast-check": "^4.10.2",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.2",
    "vitest": "^5.1.0"
  }
}
