{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "routing": {
      "default": {},
      "type": "object",
      "properties": {
        "profile": {
          "default": "off",
          "type": "string",
          "enum": [
            "off",
            "balanced",
            "strict"
          ]
        },
        "tiers": {
          "default": {},
          "type": "object",
          "properties": {
            "reasoning": {
              "default": "auto",
              "type": "string",
              "minLength": 1,
              "description": "\"auto\" or a model id"
            },
            "worker": {
              "default": "auto",
              "type": "string",
              "minLength": 1,
              "description": "\"auto\" or a model id"
            }
          },
          "additionalProperties": false
        },
        "delegation": {
          "default": {},
          "type": "object",
          "properties": {
            "read": {
              "default": {},
              "type": "object",
              "properties": {
                "minBytes": {
                  "default": 32768,
                  "description": "Main-agent reads at or above this size go to bulk-reader",
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "rangeExemptLines": {
                  "default": 400,
                  "description": "Ranged reads up to this many lines stay with the main agent",
                  "type": "integer",
                  "exclusiveMinimum": 0,
                  "maximum": 9007199254740991
                },
                "exclude": {
                  "default": [],
                  "description": "Glob patterns (relative to a session repo root, or absolute) the main agent may read whole at any size",
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              },
              "additionalProperties": false
            },
            "output": {
              "default": {},
              "type": "object",
              "properties": {
                "maxBytes": {
                  "default": 16384,
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                }
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "budget": {
      "default": {},
      "type": "object",
      "properties": {
        "sessionCredits": {
          "default": 300,
          "type": "number",
          "minimum": 0
        },
        "workspaceDailyCredits": {
          "default": 3000,
          "type": "number",
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "permissions": {
      "default": {},
      "type": "object",
      "properties": {
        "mode": {
          "default": "ask",
          "type": "string",
          "enum": [
            "ask",
            "auto"
          ]
        },
        "mcpTools": {
          "description": "Per-tool MCP permissions; an exact tool beats server/*. Overrides mode and the write-class default",
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "tool": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*\\/([A-Za-z0-9._-]+|\\*)$",
                "description": "\"server/tool\" or \"server/*\""
              },
              "permission": {
                "type": "string",
                "enum": [
                  "allow",
                  "ask",
                  "deny"
                ]
              }
            },
            "required": [
              "tool",
              "permission"
            ],
            "additionalProperties": false
          }
        },
        "tools": {
          "description": "Answers to permission prompts; a rule with match beats one without, and deny beats allow",
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "tool": {
                "type": "string",
                "minLength": 1,
                "description": "The tool name, as the approval names it"
              },
              "match": {
                "description": "The call's command, path or url argument, exactly; omit to match every call of the tool",
                "type": "string",
                "minLength": 1
              },
              "permission": {
                "type": "string",
                "enum": [
                  "allow",
                  "deny"
                ]
              }
            },
            "required": [
              "tool",
              "permission"
            ],
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "hooks": {
      "default": {},
      "type": "object",
      "properties": {
        "sessionStart": {
          "default": [],
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "description": "Shown when the hook fails; defaults to the command",
                "type": "string",
                "minLength": 1
              },
              "command": {
                "type": "string",
                "minLength": 1,
                "description": "Run with /bin/sh -c in the session or repository directory"
              },
              "timeoutSeconds": {
                "default": 60,
                "description": "The hook is killed when it runs longer",
                "type": "number",
                "exclusiveMinimum": 0,
                "maximum": 600
              }
            },
            "required": [
              "command"
            ],
            "additionalProperties": false
          }
        },
        "sessionEnd": {
          "default": [],
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "description": "Shown when the hook fails; defaults to the command",
                "type": "string",
                "minLength": 1
              },
              "command": {
                "type": "string",
                "minLength": 1,
                "description": "Run with /bin/sh -c in the session or repository directory"
              },
              "timeoutSeconds": {
                "default": 60,
                "description": "The hook is killed when it runs longer",
                "type": "number",
                "exclusiveMinimum": 0,
                "maximum": 600
              }
            },
            "required": [
              "command"
            ],
            "additionalProperties": false
          }
        },
        "beforeCommit": {
          "default": [],
          "description": "A hook that exits non-zero blocks the commit",
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "description": "Shown when the hook fails; defaults to the command",
                "type": "string",
                "minLength": 1
              },
              "command": {
                "type": "string",
                "minLength": 1,
                "description": "Run with /bin/sh -c in the session or repository directory"
              },
              "timeoutSeconds": {
                "default": 60,
                "description": "The hook is killed when it runs longer",
                "type": "number",
                "exclusiveMinimum": 0,
                "maximum": 600
              }
            },
            "required": [
              "command"
            ],
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false,
  "$id": "urn:pica:config",
  "title": "Pica configuration (config.jsonc)"
}
