// Two turns: a summary that reads a file and delegates to a worker, then a follow-up that fails partway.
{
  "version": 1,
  "models": [
    { "id": "model-a", "name": "Model A" },
    { "id": "model-b", "name": "Model B" }
  ],
  "defaultModel": "model-a",
  "turns": [
    {
      "prompt": "summarize the README",
      "steps": [
        { "type": "toolCall", "name": "view", "arguments": { "path": "README.md" }, "result": "# Acme API\nPayments service." },
        { "type": "usage", "model": "model-a", "inputTokens": 1200, "cachedInputTokens": 800, "outputTokens": 90 },
        { "type": "text", "content": "The README describes the Acme payments API." },
        {
          "type": "subagent",
          "agentName": "bulk-reader",
          "model": "model-b",
          "steps": [{ "type": "usage", "model": "model-b", "inputTokens": 300, "outputTokens": 40 }]
        }
      ]
    },
    {
      "prompt": "now deploy it",
      "steps": [
        { "type": "text", "content": "Deploying." },
        { "type": "usage", "model": "model-a", "inputTokens": 500, "cachedInputTokens": 400, "outputTokens": 20 },
        { "type": "error", "code": "runtime.quota_exhausted", "message": "Monthly premium requests are used up." }
      ]
    }
  ]
}
